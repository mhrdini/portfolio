{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  "previews": {},
  "observability": {
    "enabled": true
  }
}
